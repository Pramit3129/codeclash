generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
}

enum SubmissionLanguage {
  PYTHON
  JAVA
  CPP
  JAVASCRIPT
}

enum SubmissionVerdict {
  AC
  WA
  TLE
  MLE
  RE
  OLE
  CE
}

// Lifecycle of a submission, kept separate from `verdict`.
//
// `verdict` alone cannot distinguish "still queued" from "the worker died
// mid-run" — both leave it null — which strands submissions in a state the
// API cannot explain. FAILED means an infrastructure fault, never a judge
// result, so an outage is never reported to a user as WA/RE.
enum SubmissionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}


model User {
  id String @id @default(cuid())

  // Unique handle used for login / mentions. Auto-generated for OAuth signups.
  username String @unique

  // Human friendly name shown in UI.
  displayName String

  avatar String?

  role UserRole @default(USER)

  accounts AuthAccount[]
  sessions Session[]

  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
}

// A single authentication method attached to a user.
// A user may have one LOCAL, one GOOGLE and one GITHUB account linked together.
model AuthAccount {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider AuthProvider

  // Provider specific stable identifier.
  //  - LOCAL  -> normalized (lowercased) email
  //  - GOOGLE -> Google "sub"
  //  - GITHUB -> GitHub numeric user id (as string)
  providerUserId String

  email         String?
  emailVerified Boolean @default(false)

  // LOCAL only. bcrypt hash.
  passwordHash String?

  // OAuth provider tokens (encrypted with AES-256-GCM). GitHub only in practice.
  encryptedAccessToken  String?
  encryptedRefreshToken String?

  // Granted OAuth scopes.
  scopes String[] @default([])

  // Provider access-token expiry.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@index([email])
}

// A long-lived refresh session. The raw refresh token is never stored, only its
// SHA-256 hash. Supports rotation with reuse (theft) detection.
model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash         String
  previousRefreshTokenHash String?

  // Bumped on every rotation. Embedded in issued access tokens so a rotated /
  // revoked session immediately invalidates outstanding access tokens on refresh.
  tokenVersion Int @default(1)

  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  rotatedAt  DateTime?

  ipAddress  String?
  userAgent  String?
  deviceName String?

  isRevoked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([refreshTokenHash])
  @@index([userId])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Problem {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  statementMd   String
  constraintsMd String?
  difficulty    Difficulty
  timeLimitMs   Int
  memoryLimitMb Int
  starterCode   Json       @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  testCases   TestCase[]
  submissions Submission[]
}

model TestCase {
  id             String  @id @default(cuid())
  problemId      String
  ordinal        Int
  input          String
  expectedOutput String
  isSample       Boolean @default(false)

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  submissionResults SubmissionTestResult[]

  @@unique([problemId, ordinal])
  @@index([problemId])
}

model Submission {
  id String @id @default(cuid())

  userId    String
  problemId String

  language   SubmissionLanguage
  sourceCode String

  status SubmissionStatus @default(QUEUED)

  verdict SubmissionVerdict?

  // Set only when status = FAILED. Operator-facing description of an
  // infrastructure fault; never contains source code or secrets.
  failureReason String?

  passedTestCases Int @default(0)
  totalTestCases  Int @default(0)

  failedTestCaseId String?

  executionTimeMs Float?

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  testResults SubmissionTestResult[]

  @@index([userId, createdAt])
  @@index([problemId, createdAt])
  @@index([verdict])
  // Supports the recovery sweep for submissions stranded in RUNNING.
  @@index([status, createdAt])
}

model SubmissionTestResult {
  id String @id @default(cuid())

  submissionId String
  testCaseId   String

  verdict SubmissionVerdict

  stdout String @default("")
  stderr String @default("")

  exitCode Int?

  executionTimeMs Float

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCase   TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([submissionId, testCaseId])
  @@index([submissionId])
  @@index([testCaseId])
}
