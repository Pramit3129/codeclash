PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/codeclash?schema=public"
REDIS_URL="redis://localhost:6379"

FRONTEND_URL=http://localhost:5173
# Optional comma-separated CORS allow-list (defaults to FRONTEND_URL)
# CORS_ORIGINS=http://localhost:5173,https://app.example.com

# ----- Auth / tokens -----
# Use a long random string (>= 32 chars). e.g. `openssl rand -base64 48`
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_ISSUER=codeclash
JWT_AUDIENCE=codeclash-client
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
BCRYPT_ROUNDS=12

# 32-byte key as 64 hex chars. Generate with: `openssl rand -hex 32`
ENCRYPTION_KEY=change_me_64_hex_characters_representing_32_random_bytes_00000000

# Refresh-token cookie
COOKIE_NAME=cc_rt
# COOKIE_DOMAIN=.example.com

# ----- Google OAuth -----
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ----- GitHub OAuth -----
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/github/callback
GITHUB_SCOPES=read:user user:email repo
